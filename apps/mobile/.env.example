# Copy to .env.local and fill in. Only EXPO_PUBLIC_* vars are exposed to the
# app bundle — never put the Supabase service-role or Anthropic key here.
# Those stay server-side in apps/web/.env.local (the API routes).

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Base URL of the deployed Next.js API (apps/web on Vercel). The native app
# calls the same /api/* routes the web app uses.
EXPO_PUBLIC_API_BASE_URL=https://your-perene-deployment.vercel.app

# RevenueCat iOS public SDK key (starts with appl_), from the RevenueCat
# dashboard → Project Settings → API Keys. Public/publishable, safe in the
# bundle. Subscriptions are disabled until this is set.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
