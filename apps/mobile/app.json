{
  "expo": {
    "name": "Perene",
    "slug": "perene",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "perene",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "backgroundColor": "#F5F1E8",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.perene.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Perene uses your camera so you can photograph clothing to add to your closet.",
        "NSPhotoLibraryUsageDescription": "Perene needs access to your photos so you can add existing clothing pictures to your closet.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.perene.app",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2A3D2E"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Perene needs access to your photos so you can add existing clothing pictures to your closet.",
          "cameraPermission": "Perene uses your camera so you can photograph clothing to add to your closet."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 220,
          "backgroundColor": "#2A3D2E",
          "resizeMode": "contain"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#2A3D2E"
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0ab62db8-0021-4d82-9a74-8010a65f0843"
      }
    },
    "owner": "beejal.sangani"
  }
}
