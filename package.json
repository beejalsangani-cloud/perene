{
  "name": "perene-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "web": "npm run dev --workspace @perene/web",
    "web:build": "npm run build --workspace @perene/web",
    "mobile": "npm run start --workspace @perene/mobile"
  },
  "engines": {
    "node": ">=20"
  }
}
