# ─────────────────────────────────────────────────────────────
# Monorepo root .gitignore (covers apps/web, apps/mobile, packages/*)
# ─────────────────────────────────────────────────────────────

# dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# env files (can opt-in for committing if needed)
.env*
!.env.example

# misc
.DS_Store
*.pem
*.tsbuildinfo

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── apps/web (Next.js) ────────────────────────────────────────
.next/
out/
build/
/coverage
next-env.d.ts
.vercel
# waitlist emails — do not commit
apps/web/data/waitlist.json

# ── apps/mobile (Expo / React Native) ─────────────────────────
.expo/
dist/
web-build/
expo-env.d.ts
# native build output (managed by EAS / prebuild)
apps/mobile/ios/
apps/mobile/android/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
